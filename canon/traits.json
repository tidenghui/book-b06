[
  {
    "who": "沈知意",
    "trait": "说话平直，不哭不劝，用具体数字和事实说话（如“明早这碗里剩多少，我就知道该找谁说话”）",
    "fromChapter": 1
  },
  {
    "who": "沈知兰",
    "trait": "说话刻薄带笑，爱用团扇扇柄点东西，点一下说一句",
    "fromChapter": 1
  },
  {
    "who": "王氏",
    "trait": "说话慢，像说早定了的事，用帕子按嘴角，帕角绣半开牡丹金线",
    "fromChapter": 1
  },
  {
    "who": "shenzhiyi",
    "trait": "用铜钱划印计数，屈手指默数",
    "fromChapter": 2
  },
  {
    "who": "xiaoyan",
    "trait": "说话低，像从喉咙底刮出来",
    "fromChapter": 2
  },
  {
    "who": "fulai",
    "trait": "紧张时喉结滚动，手指捻围裙边",
    "fromChapter": 2
  },
  {
    "who": "shenzhilan",
    "trait": "说话时爱用团扇，扇柄往桌沿、廊柱、手心里敲；被戳中时绞帕子、指结发白。",
    "fromChapter": 3
  },
  {
    "who": "shenzhiyi",
    "trait": "说话不高不低，不接对方的刺，只把话头拨回对方身上问准信。",
    "fromChapter": 3
  },
  {
    "who": "xiaoyan",
    "trait": "说话不紧不慢像念单子；咳时不捂嘴；数手指头一根一根伸开又曲回。",
    "fromChapter": 3
  },
  {
    "who": "萧衍",
    "trait": "说话低哑，常只说短句，如“端来”“明天那碗，也端来”。",
    "fromChapter": 4
  },
  {
    "who": "沈知意",
    "trait": "说话声音平，一字一字落在砖缝里，动作不快不慢。",
    "fromChapter": 4
  },
  {
    "who": "灰布短打男人",
    "trait": "说话嗓子像砂纸磨过，看人时眼睛不转。",
    "fromChapter": 4
  },
  {
    "who": "shenzhiyi",
    "trait": "说话声音平平的，报账一笔一笔不添不减",
    "fromChapter": 5
  },
  {
    "who": "shenzhilan",
    "trait": "拿团扇柄挑料子比身，说话带笑带刺，爱抬下巴",
    "fromChapter": 5
  },
  {
    "who": "xiaozhang",
    "trait": "说话声音像从嗓子眼里挤出来，头低得厉害，攥罐子手指一节节收紧",
    "fromChapter": 5
  },
  {
    "who": "shenzhiyi",
    "trait": "出门前换半旧衣裳，说太新的衣裳压不住人",
    "fromChapter": 6
  },
  {
    "who": "shenzhiyi",
    "trait": "说话时指间转铜钱",
    "fromChapter": 6
  },
  {
    "who": "xiaoyan",
    "trait": "说话短促，常背对人不睁眼",
    "fromChapter": 6
  },
  {
    "who": "shenzhiyi",
    "trait": "说话平、急而硬，一句追一句，念账时一字一字往门缝里送",
    "fromChapter": 7
  },
  {
    "who": "xiaoyan",
    "trait": "开口先报全名“九王萧衍”，声音不高但一个字一个字说清楚",
    "fromChapter": 7
  },
  {
    "who": "qinghe",
    "trait": "紧张时轻轻磕牙，压低声音报信",
    "fromChapter": 7
  },
  {
    "who": "zhou",
    "trait": "说话时山羊胡一抖一抖，紧张时指甲盖泛白。",
    "fromChapter": 8
  },
  {
    "who": "shenzhiyi",
    "trait": "添茶极慢，茶水贴盏壁下去一点声也没有。",
    "fromChapter": 8
  },
  {
    "who": "zhou",
    "trait": "提笔写供词时笔尖停顿，墨洇出小点，用指头抹掉。",
    "fromChapter": 8
  },
  {
    "who": "shenzhiyi",
    "trait": "缝衣咬线，说话直硬，算得清利害",
    "fromChapter": 9
  },
  {
    "who": "xiaoyan",
    "trait": "手抖系不上领带，走路扶柱喘，咳时掩袖",
    "fromChapter": 9
  },
  {
    "who": "qinghe",
    "trait": "说话压气音，手绞围裙，跑腿盯梢",
    "fromChapter": 9
  },
  {
    "who": "萧衍",
    "trait": "走路时左肩塌着，右肩旧伤把衣服顶起一个尖，每迈一步那个尖就动一下。",
    "fromChapter": 10
  },
  {
    "who": "周太医",
    "trait": "紧张时山羊胡一抖一抖，两只手在袖口里绞，指甲盖泛白。",
    "fromChapter": 10
  },
  {
    "who": "沈知意",
    "trait": "说话平得像在报账，用“你进去是往后死，你不进去是今天死”这类对仗句逼人。",
    "fromChapter": 10
  },
  {
    "who": "shenzhiyi",
    "trait": "说话平得像在报账，先摆物证再反问",
    "fromChapter": 11
  },
  {
    "who": "xiaoyan",
    "trait": "起身前先撑榻沿，撑两回才坐直，咳血后把帕子叠好压在枕下",
    "fromChapter": 11
  },
  {
    "who": "zhouTaiyi",
    "trait": "被质问时两手在袖口里绞，指甲盖泛白，山羊胡抖",
    "fromChapter": 11
  },
  {
    "who": "shenzhiyi",
    "trait": "数咳声时用炭笔在账页角上画弯钩，一声一个钩，能凭弯钩深浅分辨咳声真假。",
    "fromChapter": 12
  },
  {
    "who": "xiaoyan",
    "trait": "真咳时右肩往下塌，喉底有拉锯声；假咳时收得利落，肩不动。",
    "fromChapter": 12
  },
  {
    "who": "xiaoyan",
    "trait": "走路慢，左肩塌着，右肩尖一动一动。",
    "fromChapter": 12
  }
]
